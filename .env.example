OLLAMA_HOST=http://127.0.0.1:11434
# Distilled student default (fallback: qwen2.5:3b)
OLLAMA_MODEL=voyage-student-1-5b-dayfix
STUDENT_MODE=true
TRIP_BASE_URL=https://hk.trip.com
TRIP_LOCALE=en_hk
TRIP_CURRENCY=HKD
HEADLESS=true
# Speed: fewer tool rounds + skip extra LLM ranking of scrape candidates
MAX_TOOL_ROUNDS=8
STUDENT_MAX_TOOL_ROUNDS=4
FAST_MODE=true
LLM_RANK_CANDIDATES=false
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2
