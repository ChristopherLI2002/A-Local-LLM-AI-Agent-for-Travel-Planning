OLLAMA_HOST=http://localhost:11434
# Lighter default for faster local replies (pull with: ollama pull qwen2.5:3b)
OLLAMA_MODEL=qwen2.5:3b
TRIP_BASE_URL=https://hk.trip.com
TRIP_LOCALE=en_hk
TRIP_CURRENCY=HKD
HEADLESS=true
# Speed: fewer tool rounds + skip extra LLM ranking of scrape candidates
MAX_TOOL_ROUNDS=8
FAST_MODE=true
LLM_RANK_CANDIDATES=false
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_TEMPERATURE=0.2
